<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>Eto.DevExtension.VisualStudio.Windows</RootNamespace>
    <UseWPF>true</UseWPF>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <AssemblyTitle>Eto.VisualStudio</AssemblyTitle>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <OutputPath>$(BaseOutputPath)$(VSVersion)\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DefineConstants>$(DefineConstants);WINDOWS;VS$(VSVersion)</DefineConstants>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- CI has no experimental instance to deploy to -->
    <DeployExtension Condition="'$(DeployExtension)' == '' AND '$(CI)' != 'true'">true</DeployExtension>
  </PropertyGroup>
  <PropertyGroup>
    <VSSDKBuildToolsAutoSetup>true</VSSDKBuildToolsAutoSetup>
    <UseCodebase>true</UseCodebase>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <TemplateSourceRoot>$(MSBuildProjectDirectory)\Templates\</TemplateSourceRoot>
    <DefaultNewProjectNode>CSharp\Eto.Forms</DefaultNewProjectNode>
    <TargetVsixContainerName>Eto.DevExtension.VisualStudio.Windows.$(VSVersion)-$(PackageVersion).vsix</TargetVsixContainerName>
    <TargetVsixContainer>$(ArtifactsDir)$(Configuration)\$(TargetVsixContainerName)</TargetVsixContainer>
  </PropertyGroup>
  <ItemGroup>
    <!-- lets Visual Studio find the template wizard by its assembly name -->

    <AssemblyAttribute Include="Microsoft.VisualStudio.Shell.ProvideCodeBaseAttribute">
      <AssemblyName>$(AssemblyName)</AssemblyName>
      <Version>$(Version)</Version>
      <CodeBase>$PackageFolder$\$(AssemblyName).dll</CodeBase>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <Content Include="$(PkgEto_Forms)\lib\netstandard2.0\Eto.xml" Link="Eto.xml" />
    <Content Include="..\..\LICENSE" Link="LICENSE" />
    <Content Include="PreviewImage.png" CopyToOutputDirectory="Never" />
    <Content Include="Icon.png" CopyToOutputDirectory="Never" />
    <Content Include="template.pkgdef" CopyToOutputDirectory="Never" />
    <Content Include="$(PkgEto_Forms_Templates)\*.nupkg" Link="Eto.Forms.Templates.nupkg" CopyToOutputDirectory="Never" />
    <Resource Include="Templates\**\*.ico" />
    <None Remove="PreviewImage.png;Icon.png;template.pkgdef;Templates\**\*.ico" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="VSPackage.resx">
      <MergeWithCTO>true</MergeWithCTO>
      <ManifestResourceName>VSPackage</ManifestResourceName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Eto.Designer\Eto.Designer.csproj" />
    <ProjectReference Include="..\Eto.DevExtension.Shared\Eto.DevExtension.Shared.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Microsoft.Build" />
    <Reference Include="ReachFramework" />
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.Design" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Windows.Presentation" />
    <Reference Include="WindowsFormsIntegration" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Eto.Forms" GeneratePathProperty="True" />
    <PackageReference Include="Eto.Platform.Wpf" />
    <PackageReference Include="Eto.Serialization.Json" />
    <PackageReference Include="Eto.Serialization.Xaml" />
    <PackageReference Include="Eto.Forms.Templates" GeneratePathProperty="true" PrivateAssets="all" />
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Portable.Xaml" />
    <PackageReference Include="Extended.Wpf.Toolkit" />
  </ItemGroup>
  <Choose>
    <!-- covers VS 2022 and VS 2026, which loads 17.x extensions -->
    <When Condition="$(VSVersion) == '2022'">
      <ItemGroup>
        <PackageReference Include="Microsoft.VisualStudio.SDK" ExcludeAssets="runtime">
          <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.VSSDK.BuildTools">
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
          <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.VisualStudio.TemplateWizardInterface" />
      </ItemGroup>
    </When>
  </Choose>
  <Import Project="Properties\wafflebuilder.targets" />
  <!-- source.extension.vsixmanifest asks for this, so the version is only set in Directory.Build.props -->
  <Target Name="GetVsixVersion" Returns="$(Version)" />
  <Target Name="UpdateNugetReferences" AfterTargets="PrepareResources">
    <!-- this updates our PackageReferences to be copy local -->
    <ItemGroup>
      <ReferencePath Update="%(ReferencePath.Identity)" Condition="%(Filename) == 'Portable.Xaml'" CopyLocal="True" />
      <ReferencePath Update="%(ReferencePath.Identity)" Condition="%(Filename) == 'FSharp.Compiler.CodeDom'" CopyLocal="True" />
    </ItemGroup>
  </Target>
  <Target Name="ClearTemplateCache" AfterTargets="AfterBuild">
    <RemoveDir Directories="$(HOMEDRIVE)$(HOMEPATH)\.templateengine\vs" />
  </Target>
  <!-- completions run in the same .NET language server as VS Code, so ship it in the vsix -->
  <PropertyGroup>
    <LanguageServerProject>$(MSBuildProjectDirectory)\..\Eto.DevExtension.LanguageServer\Eto.DevExtension.LanguageServer.csproj</LanguageServerProject>
    <LanguageServerPublishDir>$(ArtifactsDir)Eto.DevExtension.LanguageServer\publish\$(Configuration)\</LanguageServerPublishDir>
  </PropertyGroup>
  <Target Name="PublishLanguageServer" BeforeTargets="GetVsixSourceItems">
    <Exec Command="dotnet publish &quot;$(LanguageServerProject)&quot; -c $(Configuration) -o &quot;$(LanguageServerPublishDir.TrimEnd('\'))&quot; --nologo -v q" />
    <ItemGroup>
      <LanguageServerFile Include="$(LanguageServerPublishDir)**\*" Exclude="$(LanguageServerPublishDir)**\*.pdb" />
      <VSIXSourceItem Include="@(LanguageServerFile)" VSIXSubPath="server\%(RecursiveDir)" />
    </ItemGroup>
  </Target>
  <!-- previews are drawn by a separate .NET process so project code never loads into Visual Studio -->
  <PropertyGroup>
    <PreviewHostProject>$(MSBuildProjectDirectory)\..\Eto.DevExtension.PreviewHost\Eto.DevExtension.PreviewHost.csproj</PreviewHostProject>
    <PreviewHostPublishDir>$(ArtifactsDir)Eto.DevExtension.PreviewHost\publish\$(Configuration)\</PreviewHostPublishDir>
  </PropertyGroup>
  <!-- win draws with Wpf or WinForms, net with Gtk -->
  <Target Name="PublishPreviewHost" BeforeTargets="GetVsixSourceItems">
    <Exec Command="dotnet publish &quot;$(PreviewHostProject)&quot; -f net8.0-windows -c $(Configuration) -o &quot;$(PreviewHostPublishDir)win&quot; --nologo -v q" />
    <Exec Command="dotnet publish &quot;$(PreviewHostProject)&quot; -f net8.0 -c $(Configuration) -o &quot;$(PreviewHostPublishDir)net&quot; --nologo -v q" />
    <ItemGroup>
      <PreviewHostWinFile Include="$(PreviewHostPublishDir)win\**\*" Exclude="$(PreviewHostPublishDir)win\**\*.pdb" />
      <VSIXSourceItem Include="@(PreviewHostWinFile)" VSIXSubPath="preview\win\%(RecursiveDir)" />
      <PreviewHostNetFile Include="$(PreviewHostPublishDir)net\**\*" Exclude="$(PreviewHostPublishDir)net\**\*.pdb" />
      <VSIXSourceItem Include="@(PreviewHostNetFile)" VSIXSubPath="preview\net\%(RecursiveDir)" />
    </ItemGroup>
  </Target>
  <Target Name="CreateDirectory for vsix" BeforeTargets="CreateVsixContainer">
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName($(TargetVsixContainer)))" />
  </Target>
</Project>
