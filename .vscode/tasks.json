{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-extension",
            "type": "shell",
            "windows": {
                "command": "${input:msbuild}",
                "args": [
                    "/restore",
                    "/v:Minimal",
                    // "/p:Configuration=Release",
                    "/p:VSVersion=2022",
                    "/p:DeployExtension=true",
                    "${workspaceFolder}/src/Eto.DevExtension.VisualStudio.Windows/Eto.DevExtension.VisualStudio.Windows.csproj",
                ],
            },
            "args": [],
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "clear": true
            },
            "group": "build"
        },
        {
            "label": "build-vscode-extension",
            "type": "shell",
            "command": "npm",
            "args": [ "run", "build:server", "--silent" ],
            "options": {
                "cwd": "${workspaceFolder}/src/Eto.DevExtension.VSCode"
            },
            "dependsOn": [ "compile-vscode-extension" ],
            "problemMatcher": "$msCompile",
            "group": "build"
        },
        {
            "label": "compile-vscode-extension",
            "type": "shell",
            "command": "npm",
            "args": [ "run", "compile", "--silent" ],
            "options": {
                "cwd": "${workspaceFolder}/src/Eto.DevExtension.VSCode"
            },
            "problemMatcher": "$tsc",
            "group": "build"
        },
        {
            "label": "build-rider-plugin",
            "type": "shell",
            "command": "./gradlew",
            "windows": {
                "command": ".\\gradlew.bat"
            },
            "args": [ "buildPlugin" ],
            "options": {
                "cwd": "${workspaceFolder}/src/Eto.DevExtension.Rider"
            },
            "problemMatcher": [],
            "group": "build"
        },
        {
            // waits for a debugger on port 5005 before Rider starts
            "label": "run-rider-debug",
            "type": "shell",
            "command": "./gradlew",
            "windows": {
                "command": ".\\gradlew.bat"
            },
            "args": [ "runIde", "--debug-jvm" ],
            "options": {
                "cwd": "${workspaceFolder}/src/Eto.DevExtension.Rider"
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "gradle",
                "pattern": { "regexp": "^\\b$" },
                "background": {
                    "beginsPattern": "Using Rider|No local Rider found",
                    "endsPattern": "Listening for transport dt_socket at address"
                }
            }
        }
    ],
    "inputs": [
        {
            "id": "msbuild",
            "type": "command",
            "command": "shellCommand.execute",
            "args": {
                "command": "\"%ProgramFiles(x86)%\\Microsoft Visual Studio\\Installer\\vswhere.exe\" -latest -version \"17\" -products * -requires Microsoft.Component.MSBuild -find MSBuild\\**\\Bin\\amd64\\MSBuild.exe",
                "useFirstResult": "true"
            }
        }
    ]
}
