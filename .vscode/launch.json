{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Eto.DevExtension.VSCode",
            "type": "extensionHost",
            "request": "launch",
            "preLaunchTask": "build-vscode-extension",
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}/src/Eto.DevExtension.VSCode"
            ],
            "outFiles": [
                "${workspaceFolder}/src/Eto.DevExtension.VSCode/out/**/*.js"
            ]
        },
        {
            // runs the newest Rider installed, or set riderPath in src/Eto.DevExtension.Rider/gradle.properties
            "name": "Eto.DevExtension.Rider",
            "type": "node-terminal",
            "request": "launch",
            "command": "./gradlew runIde",
            "windows": {
                "command": ".\\gradlew.bat runIde"
            },
            "cwd": "${workspaceFolder}/src/Eto.DevExtension.Rider"
        },
        {
            // needs the Debugger for Java extension
            "name": "Eto.DevExtension.Rider (debug)",
            "type": "java",
            "request": "attach",
            "hostName": "localhost",
            "port": 5005,
            "preLaunchTask": "run-rider-debug"
        },
        {
            "name": "Eto.DevExtension.VisualStudio.Windows.2022",
            "type": "clr",
            "request": "launch",
            "preLaunchTask": "build-extension",
            "program": "${input:devenv-17}",
            "args": [
                "/RootSuffix",
                "Exp"
            ],
        },
        {
            "name": "Eto.DevExtension.VisualStudio.Windows.2026",
            "type": "clr",
            "request": "launch",
            "preLaunchTask": "build-extension",
            "program": "${input:devenv-18}",
            "args": [
                "/RootSuffix",
                "Exp"
            ],
        }
    ],
    "compounds": [],
    "inputs": [
        {
            "id": "devenv-17",
            "type": "command",
            "command": "shellCommand.execute",
            "args": {
                "command": "\"%ProgramFiles(x86)%\\Microsoft Visual Studio\\Installer\\vswhere.exe\" -version \"[17,18)\" -products * -requires Microsoft.Component.MSBuild -find Common7\\IDE\\devenv.exe",
                "useFirstResult": "true"
            }
        },
        {
            "id": "devenv-18",
            "type": "command",
            "command": "shellCommand.execute",
            "args": {
                "command": "\"%ProgramFiles(x86)%\\Microsoft Visual Studio\\Installer\\vswhere.exe\" -version \"[18,19)\" -products * -requires Microsoft.Component.MSBuild -find Common7\\IDE\\devenv.exe",
                "useFirstResult": "true"
            }
        }
    ]

}
